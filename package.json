{
  "name": "flow",
  "version": "1.21.0",
  "description": "AI 原生跨境出货台 · AI-Native Cross-Border Commerce Platform (storefront + seller AI workbench)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run build:server && concurrently -k -n tsc,node -c yellow,blue \"npm:dev:server:tsc\" \"npm:dev:server:node\"",
    "dev:server:tsc": "tsc -p tsconfig.node.json --watch --preserveWatchOutput",
    "dev:server:node": "node --watch dist-server/server/main.js",
    "dev:client": "vite --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.node.json",
    "build:client": "vite build --config vite.config.ts",
    "start": "node dist-server/server/main.js",
    "start:prod": "node dist-server/server/main.js",
    "type:check": "concurrently -n server,client -c blue,green \"npm:type:check:server\" \"npm:type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:push": "drizzle-kit push",
    "test:coverage": "vitest run --coverage",
    "mock:providers": "node scripts/mock-providers.mjs",
    "smoke:providers": "node scripts/smoke-providers.mjs",
    "smoke:degraded": "node scripts/smoke-ai-degraded.mjs",
    "smoke:workflows": "node scripts/smoke-workflows.mjs",
    "smoke:copilot": "node scripts/smoke-copilot.mjs",
    "smoke:shopper": "node scripts/smoke-shopper.mjs",
    "verify:watch-mutex": "node scripts/verify-watch-mutex.mjs",
    "capture": "node scripts/capture/screenshots.mjs",
    "capture:video": "node scripts/capture/record-demo.mjs",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"scripts/**/*.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "cli": "node scripts/cli.mjs",
    "smoke:all": "node scripts/run-all-smoke.mjs",
    "capture:all": "node scripts/capture/run-capture.mjs"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.4.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.53.0",
    "nanoid": "^3.3.20",
    "nodemailer": "^7.0.9",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.30.6",
    "embedded-postgres": "^17.5.0-beta.15",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.29",
    "postcss-import": "^17.0.0",
    "prettier": "^3.6.2",
    "puppeteer-core": "^25.14.0",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.4",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}

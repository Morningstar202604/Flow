{
  "name": "globalecom-ai",
  "version": "1.1.0",
  "description": "AI 原生跨境出货台 · AI-Native Cross-Border Commerce Platform",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "NODE_ENV=development tsx watch server/main.ts",
    "dev:client": "NODE_ENV=development vite --config vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.node.json",
    "build:client": "NODE_ENV=production vite build --config vite.config.ts",
    "start": "NODE_ENV=production node dist-server/main.js",
    "start:prod": "NODE_ENV=production node dist-server/main.js",
    "type:check": "concurrently -n server,client -c blue,green \"npm:type:check:server\" \"npm:type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "lint": "eslint . --quiet",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },

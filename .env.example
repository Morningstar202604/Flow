# Flow 出口电商平台 — 环境变量模板
# 用法：cp .env.example .env 后按需填写
# 未配置的第三方能力自动降级为演示模式（支付/物流）；AI 未配置 key 时诚实返回 400

# ============================================================
# 基础
# ============================================================

# 运行环境（production / development）。本地 npm start 时也需要在此设置 production
NODE_ENV=production
PORT=3000
# 应用对外访问地址（用于 OAuth 回调、支付回跳等）
APP_URL=https://your-domain.com

# ============================================================
# 数据库
# ============================================================

# PostgreSQL 连接串（docker compose 部署时 host 填 postgres）
DATABASE_URL=postgresql://flow:flow_pass@postgres:5432/flow?schema=public

# docker compose 用的数据库凭据（与上方 DATABASE_URL 保持一致）
POSTGRES_DB=flow
POSTGRES_USER=flow
POSTGRES_PASSWORD=flow_pass_2024
# PG 暴露到宿主机的端口（与本机已有 5432 冲突时修改）
# POSTGRES_PORT=5432

# ============================================================
# 认证与安全
# ============================================================

# JWT 签名密钥【生产必填，至少 32 位；openssl rand -hex 32 生成】
# 开发态缺失时使用不安全默认值，生产态缺失会拒绝启动
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# 部署在反向代理（nginx/caddy）后面时设置（1 或代理跳数），
# 使限流与审计日志拿到真实客户端 IP；未设置时不信任任何 X-Forwarded-* 头
# TRUST_PROXY=1

# Cookie 作用域（顶级域名需加 . 前缀，如 .your-domain.com）
# COOKIE_DOMAIN=.your-domain.com

# 允许的跨域来源，多个用逗号分隔（生产未设置时回退 APP_URL）
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# 卖家自助注册邀请码：设置后注册卖家必须携带该码；
# 未设置则禁止卖家自助注册（演示卖家由 SEED_DEMO_DATA 或管理员开通）
# SELLER_REGISTRATION_CODE=change-me

# 首次启动写入演示数据（分类/商品/演示卖家与买家/优惠券），数据库已有数据时自动跳过
# SEED_DEMO_DATA=false

# ============================================================
# 第三方登录（可选，未配置则不显示 Google 登录按钮）
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# AI 能力（OpenAI 兼容协议：DeepSeek / 火山方舟 / OpenAI / 通义 / 智谱等）
# 说明：卖家可在「AI 分析中心 → 模型设置」中填写（界面设置优先级更高、保存即生效）；
#       这里的 LLM_* 仅作为无界面部署的引导默认值。未配置时 AI 功能统一提示"请填写模型"。
# ============================================================

# Base URL 两种写法均可：https://api.deepseek.com 或 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com

# AI 对话模型 API Key
LLM_API_KEY=

# AI 对话模型名称（趋势分析建议使用推理模型，如 deepseek-reasoner）
LLM_MODEL=deepseek-chat

# ============================================================
# 支付（可选；未配置则对应渠道走演示模式）
# ============================================================

STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks 配置指向 {APP_URL}/api/payments/stripe-webhook
# 订阅事件：payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=
# 仅对接 API 代理/本地渠道模拟器时设置；默认 https://api.stripe.com
# STRIPE_API_BASE=http://127.0.0.1:4880/stripe

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal 环境：sandbox（沙箱）或 live（生产）
PAYPAL_MODE=sandbox
# PayPal Webhook 指向 {APP_URL}/api/payments/paypal-webhook
# 订阅事件：PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=
# 仅对接 API 代理/本地渠道模拟器时设置；默认按 PAYPAL_MODE 选择官方地址
# PAYPAL_API_BASE=http://127.0.0.1:4880/paypal

# ============================================================
# 物流追踪 — 17Track（可选；未配置则物流信息走演示模式）
# ============================================================

17TRACK_API_KEY=

# ============================================================
# 前端（构建期注入，仅跨域部署时需要）
# ============================================================

# 同源部署（推荐，单进程托管）留空；前后端分离部署时填写 API 地址
# VITE_API_BASE_URL=https://api.your-domain.com

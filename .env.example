# GlobalEcom AI 出口电商平台
# 环境变量模板 — 复制为 .env 后填入实际值
# cp .env.example .env

# ============================================================
# 基础配置
# ============================================================

# 运行环境（production / development）
NODE_ENV=production

# 应用监听端口
PORT=3000

# 应用对外访问地址（用于 OAuth 回调、支付回调等）
# 示例：https://your-domain.com
APP_URL=https://your-domain.com

# ============================================================
# 数据库
# ============================================================

# PostgreSQL 连接串（docker-compose 部署时 host 填 postgres）
DATABASE_URL=postgresql://globalecom:globalecom_pass@postgres:5432/globalecom?schema=public

# docker-compose 用的数据库凭据（与上方 DATABASE_URL 保持一致）
POSTGRES_DB=globalecom
POSTGRES_USER=globalecom
POSTGRES_PASSWORD=globalecom_pass_2024

# ============================================================
# 认证与安全
# ============================================================

# JWT 签名密钥【生产必填，至少 32 位，建议使用 openssl rand -hex 32 生成】
# 开发态未设置时会使用不安全的默认值，生产态缺失会启动失败
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# ============================================================
# 第三方登录
# ============================================================

# Google OAuth（可选，未配置则不显示 Google 登录按钮）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# AI 能力（OpenAI 兼容协议，如 DeepSeek / 通义 / 智谱等）
# ============================================================

# AI 对话模型 Base URL
LLM_BASE_URL=https://api.deepseek.com/v1

# AI 对话模型 API Key
LLM_API_KEY=

# AI 对话模型名称
LLM_MODEL=deepseek-chat

# ============================================================
# 向量嵌入（商品语义搜索用）
# ============================================================

# Embedding API Base URL（OpenAI 兼容）
EMBEDDING_BASE_URL=https://api.openai.com/v1

# Embedding API Key
EMBEDDING_API_KEY=

# Embedding 模型名称
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# 支付 — Stripe
# ============================================================

# Stripe 密钥（可选，未配置则 Stripe 支付方式走演示模式）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# 支付 — PayPal
# ============================================================

# PayPal 客户端 ID（可选，未配置则 PayPal 支付方式走演示模式）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal 环境：sandbox（沙箱）或 live（生产）
PAYPAL_MODE=sandbox

# PayPal Webhook ID（用于验证 Webhook 签名）
PAYPAL_WEBHOOK_ID=

# ============================================================
# 物流追踪 — 17Track
# ============================================================

# 17Track API Key（可选，未配置则物流信息走演示模式）
17TRACK_API_KEY=

# ============================================================
# CORS 与 Cookie（按需配置）
# ============================================================

# 允许的跨域来源，多个用逗号分隔
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Cookie 作用域（顶级域名需加 . 前缀，如 .your-domain.com）
# COOKIE_DOMAIN=.your-domain.com

# ============================================================
# Redis（可选，当前版本未启用，预留）
# ============================================================

# REDIS_URL=redis://:redis_pass@redis:6379/0
